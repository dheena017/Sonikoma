# ==============================================================================
# SONIKOMA MONOREPO .GITIGNORE
# Comprehensive Ignore Rules for React + TypeScript + Vite & FastAPI Backend
# ==============================================================================

# ── Dependencies & Virtual Environments ──────────────────────────────────────
node_modules/
.venv/
venv/
env/
ENV/

# ── Build & Production Artifacts ─────────────────────────────────────────────
dist/
dist-ssr/
build/
out/
*.tsbuildinfo

# ── Environment & Secret Credentials ─────────────────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
!.env.template
client_secrets.json
backend/data/client_secrets.json

# ── Database & Persistent Media Storage (data/ & backend/data/) ───────────────
data/
!frontend/src/features/editor_video/data/
!frontend/src/features/editor_video/data/**
backend/data/
sonikoma-test-*
sonikoma-credits-test-*
*.db
*.db-wal
*.db-shm
data/media/
data/local_media/
data/scraped_html/
data/training_data/
data/image_cache/
data/temp/
backend/data/media/
backend/data/local_media/
backend/data/scraped_html/
backend/data/training_data/
backend/database/image_cache/

# ── Python Cache & Bytecode ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.ruff_cache/
.mypy_cache/

# ── Logs & Debugging Output ──────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── IDEs & Operating System Files ────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ── Temporary Diagnostics & Scratch Scripts ──────────────────────────────────
scratch/
temp/
temp_test_combos/
skills-lock.json
verify_fix.cjs
.llm-chat-history/

yolov8n-seg.pt

# ── Playwright Testing & Trace Artifacts ─────────────────────────────────────
playwright-report/
test-results/
blob-report/
playwright/.cache/
e2e/playwright-report/
e2e/test-results/
e2e/blob-report/
*.trace.zip


# ==============================================================================
# SONIKOMA MONOREPO .GITIGNORE
# Comprehensive Ignore Rules for React + TypeScript + Vite & FastAPI Backend
# ==============================================================================

# ── Dependencies & Virtual Environments ──────────────────────────────────────
node_modules/
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# ── Build & Production Artifacts ─────────────────────────────────────────────
dist/
dist-ssr/
build/
out/
.next/
.nuxt/
*.tsbuildinfo

# ── Environment & Secret Credentials ─────────────────────────────────────────
.env
.env.*
!.env.example
!.env.template
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
client_secrets.json
**/client_secrets.json
service_account.json
**/service_account.json

# ── Database & Persistent Media Storage (data/ & backend/data/) ───────────────
data/
!frontend/src/features/editor_video/data/
!frontend/src/features/editor_video/data/**
backend/data/
sonikoma-test-*
sonikoma-credits-test-*
*.db
*.db-*
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
data/media/
data/local_media/
data/scraped_html/
data/training_data/
data/image_cache/
data/temp/
backend/data/media/
backend/data/local_media/
backend/data/scraped_html/
backend/data/training_data/
backend/database/image_cache/

# ── AI / ML Models & Heavy Weights ───────────────────────────────────────────
*.pt
*.pth
*.onnx
*.safetensors
*.bin
*.engine
*.tflite
yolov8n-seg.pt
yolov8*.pt

# ── Python Cache, Bytecode & Diagnostics ─────────────────────────────────────
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
**/.pytest_cache/
.ruff_cache/
**/.ruff_cache/
.mypy_cache/
**/.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage/
.nyc_output/
pyright_out.json
*pyright*.json

# ── Reports, Audits & Output Dumps ───────────────────────────────────────────
reports/
backend/reports/
last_scrape_audit.json
**/last_scrape_audit.json

# ── Logs & Debugging Output ──────────────────────────────────────────────────
*.log
logs/
backend/logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── IDEs & Operating System Files ────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ── Temporary Diagnostics & Scratch Scripts ──────────────────────────────────
scratch/
temp/
tmp/
temp_test_combos/
scratch_*.py
**/scratch_*.py
scratch_*.ts
**/scratch_*.ts
scratch_*.js

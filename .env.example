# =============================================================================
# Sonikoma AI Studio — Environment Configuration Template
# =============================================================================
# Copy this file to `.env` in the project root:
#   copy .env.example .env
# ⚠️  NEVER commit `.env` to version control (it is ignored in `.gitignore`).
# =============================================================================

# ── 1. Core Server & Environment Configuration ───────────────────────────────

# Environment Mode: "development" or "production"
# - development: Vite dev server runs on FRONTEND_PORT (3000) with HMR
# - production:  FastAPI serves static production bundle from frontend/dist
NODE_ENV="development"

# Computational Engine (FastAPI) Port
BACKEND_PORT=5173

# Frontend (React / Vite) Dev Server Port
FRONTEND_PORT=3000

# Public Application Base URL
APP_URL="http://localhost:3000"

# Enable the automatic training data monitor
ENABLE_TRAINING_MONITOR="true"

# Secret key used for signing JWT authentication tokens (generate a long, random string in production)
JWT_SECRET_KEY="dev_change_me_to_a_long_random_secret_key_please"

# Logging verbosity: "debug", "info", "warning", "error"
LOG_LEVEL="debug"

# Access token expiration time in minutes (default: 1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Rate Limiting: Maximum HTTP requests per minute per IP address
RATE_LIMIT_RPM=12

# Set to "true" to disable Vite Hot Module Replacement (HMR) in containerized setups
DISABLE_HMR="false"


# ── 2. AI & Vision / LLM Model Providers ─────────────────────────────────────

# REQUIRED: Google Gemini Vision API Key — https://aistudio.google.com/app/apikey
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"
GEMINI_MODEL_PRIMARY="gemini-2.5-flash"
GEMINI_FALLBACK_MODELS="gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.0-flash,gemini-2.0-flash-lite"

# OPTIONAL: HuggingFace Inference API Token — https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY="YOUR_HUGGINGFACE_API_KEY_HERE"

# OPTIONAL: OpenAI GPT-4o & DALL-E — https://platform.openai.com/api-keys
OPENAI_API_KEY="YOUR_OPENAI_API_KEY_HERE"

# OPTIONAL: Anthropic Claude — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY="YOUR_ANTHROPIC_API_KEY_HERE"

# OPTIONAL: DeepSeek Reasoning API — https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY="YOUR_DEEPSEEK_API_KEY_HERE"

# OPTIONAL: Replicate Model Hosting — https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN="YOUR_REPLICATE_API_TOKEN_HERE"


# ── 3. Audio & Voice Dubbing (TTS) ───────────────────────────────────────────

# OPTIONAL: ElevenLabs Neural Voice Synthesis — https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY="YOUR_ELEVENLABS_API_KEY_HERE"


# ── 4. Translation & Localization ────────────────────────────────────────────

# OPTIONAL: DeepL Translation API — https://www.deepl.com/pro-api
DEEPL_API_KEY="YOUR_DEEPL_API_KEY_HERE"


# ── 5. Database & Cloud Storage ──────────────────────────────────────────────

# Development: Local SQLite database is automatically resolved to: data/webtoon_local.db
# Production:  DATABASE_URL is required and must point to your PostgreSQL / Supabase pooler instance.
DATABASE_URL="postgresql://postgres:password@localhost:5432/webtoon_db"

# Supabase Project Credentials (Client-side & Server-side API integration)
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_KEY="your-supabase-anon-public-key-here"


# ── 6. OAuth & Social Publishing (Google / YouTube) ──────────────────────────

# Google OAuth2 Credentials for Google Sign-In and YouTube export
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID_HERE"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET_HERE"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/v1/auth/google/callback"

# YouTube OAuth Redirect URI for automated video export & upload
YOUTUBE_OAUTH_REDIRECT_URI="http://localhost:3000/api/v1/export/youtube/oauth/callback"
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""


# ── 7. Network, Proxy & Limits ───────────────────────────────────────────────

# Maximum allowed proxy upload size in Megabytes
MAX_PROXY_MB=20

# Optional Outbound HTTP/HTTPS Proxies
# HTTP_PROXY="http://127.0.0.1:7890"
# HTTPS_PROXY="http://127.0.0.1:7890"
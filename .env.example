# =============================================================================
# Sonikoma Webtoon-to-Video Compiler — Environment Configuration Template
# =============================================================================
# Copy this file to `.env` in the project root:
#   copy .env.example .env
# NEVER commit `.env` to version control (it is ignored in `.gitignore`).
# =============================================================================

# ── AI & ML API Credentials ───────────────────────────────────────────────────

# REQUIRED: Google Gemini Vision API Key — Powers:
#   - Storyboard AI Panel Extraction & Panel Detection
#   - Automatic Speech Bubble Erasing & OCR Text Extraction
#   - Panel Image Analysis & Character Bio Synthesis
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# OPTIONAL: HuggingFace Inference API Token — Enables:
#   - Open-source LLM options (Mistral-7B, Llama-3, Flux) in AI Studio
# Get your key at: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY="YOUR_HUGGINGFACE_API_KEY_HERE"

# OPTIONAL: Google OAuth2 Credentials for Google / YouTube Authentication
# Required to enable Google Sign-In and YouTube export. Alternatively, place client_secrets.json in backend directory.
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID_HERE"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET_HERE"
# Optional: Override redirect URI if it differs from http://localhost:3000/api/auth/google/callback
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"



# ── Server & Application Ports ────────────────────────────────────────────────

# REQUIRED: JWT Secret Key — Secret string used for signing authentication tokens.
# Must be long, random, and secure.
JWT_SECRET_KEY="your_secure_random_jwt_secret_key_here"

# Environment Mode: "development" or "production"
# In development -> Vite dev server runs on FRONTEND_PORT (3000) with HMR
# In production  -> FastAPI serves static production bundle from dist/
NODE_ENV="development"

# REQUIRED: Backend FastAPI Computational Engine Port (default: 5173)
BACKEND_PORT=5173

# REQUIRED: Frontend React/Vite Dev Server Port (default: 3000)
# Used for local development only. This must be a numeric port, not a URL.
# In production, do NOT set FRONTEND_PORT to your app domain.
FRONTEND_PORT=3000

# REQUIRED: Public Application Base URL
# In development, use http://localhost:3000
# In production, use your deployed frontend URL, e.g. https://sonikoma.vercel.app
APP_URL="http://localhost:3000"

# Rate Limiting: Maximum HTTP requests per minute per IP address
RATE_LIMIT_RPM=120

# Optional deployment secrets for GitHub Action / Vercel workflows.
# These should be stored in GitHub repository secrets, not in `.env`.
# VERCEL_TOKEN="your_vercel_token"
# VERCEL_ORG_ID="your_vercel_org_id"
# VERCEL_PROJECT_ID="your_vercel_project_id"


# ── Database & Storage Configuration ─────────────────────────────────────────

# Database Path: Default local SQLite database path is automatically resolved to:
#   backend/data/webtoon_local.db

# OPTIONAL: Supabase / PostgreSQL Connection String
# If provided, the backend automatically connects to PostgreSQL instead of local SQLite.
# Example: postgresql://postgres:password@localhost:5432/webtoon_db
DATABASE_URL="postgresql://postgres:password@localhost:5432/webtoon_db"

# Supabase Project Credentials (Client-side & Server-side API integration)
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_KEY="your-supabase-anon-public-key-here"


# ── Frontend Vite Server Configuration ──────────────────────────────────────

# Set to "true" to disable Vite Hot Module Replacement (HMR) in containerized setups
DISABLE_HMR="false"


# ── Optional Proxy Configuration ─────────────────────────────────────────────
# HTTP_PROXY="http://127.0.0.1:7890"
# HTTPS_PROXY="http://127.0.0.1:7890"
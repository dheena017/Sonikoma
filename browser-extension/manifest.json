{
  "manifest_version": 3,
  "name": "Sonikoma — AI Motion Comic & Manga Studio",
  "version": "1.0.0",
  "description": "AI-powered webtoon & manga motion video engine, real-time voice dubber, high-res chapter downloader, and viral shorts maker.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "alarms",
    "downloads",
    "contextMenus",
    "activeTab",
    "scripting",
    "declarativeNetRequest"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "Sonikoma AI Studio",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "Open Sonikoma quick popup"
    },
    "toggle-sidepanel": {
      "suggested_key": {
        "default": "Alt+S",
        "mac": "Alt+S"
      },
      "description": "Toggle Sonikoma SidePanel Mini-Studio"
    },
    "snip-panel": {
      "suggested_key": {
        "default": "Alt+P",
        "mac": "Alt+P"
      },
      "description": "Snip & Animate single panel on screen"
    },
    "download-chapter": {
      "suggested_key": {
        "default": "Alt+D",
        "mac": "Alt+D"
      },
      "description": "1-Click Download High-Res Chapter ZIP"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/*", "content/*", "sidepanel/*", "utils/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
